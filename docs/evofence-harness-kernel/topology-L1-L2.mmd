graph TD;
%% entry: 将当前 Git/worktree/子 CLI 串行候选控制器重设为 Graph Engineering 驱动的能力演化内核：DSH 与 Pi 同等首发，宿主执行而内核决策，结合长程编码、多 agent 协作与经过验证的长期演化。2026-10-01设计交付后用户已授权完整实施，采用同目录串行新session继承与handoff接力。
%% exit: 交付双宿主可用、可恢复、可解释的能力演化内核，并依据冻结协议提供真实受控收益证据与最终人审材料；未知、负结果和预算不足如实保留，不把实施或图完成当收益成立。发布另需明确授权。
%% 验收标准:
%% - DSH 与 Pi 各自在原生持续会话中完成一次包含动态子图、多 agent、验证、失败修复与恢复的真实编码任务；不得以调用 evofence run 或安装成功代替。
%% - 同一任务合同下，所有必须分支均有可核验证据；共享文件写入、合并、资源预算和取消具有明确责任与可重放记录。
%% - 在授权范围内自动调整与验证晋升；权限扩大、发布与破坏性操作由授权策略裁决；不宣称工具 hooks 等于 OS 沙箱。
%% - 具备任务完成、候选验证、能力晋升、宿主激活四个独立语义；失败或证据缺失不被抹成成功。
%% - 用冻结协议在未见任务上比较同模型与相同总预算下原 harness、图编排、图编排加长期演化；计入规划、委派、评测和学习的全部开销并提供消融与不确定性。
%% - 能力资产可追溯来源、适用范围、版本与评测证据；可撤销退化资产并继续普通宿主任务。
%% - 内核与协议可独立导入，无 CLI、Git、原生 SQLite 或 super-plumber 强制依赖；DSH/Pi 通过相同 host contract suite。
%% - 允许 breaking change，但旧 ledger/config/graph 历史保持原样；新版数据独立命名与版本化，发布另需明确授权。
%% 边样式图例:
%% decides/fallback/iterates = 虚线箭头；relates = 点线；shares_context = 无箭头实线；其余 = 实线箭头
  %% 节点定义 (按状态着色)
  %% 知识顶点 (context/ADR 横切领域知识，不入分期带)
  adr_0001{{"宿主内嵌内核与显式子图委托"}}:::adr_proposed;
  adr_0002{{"动态 Graph Engineering 与有界 agent loops"}}:::adr_proposed;
  adr_0003{{"真实授权与能力协商替代品牌白名单"}}:::adr_proposed;
  adr_0004{{"事件真相源、outbox 与恢复核实"}}:::adr_proposed;
  adr_0008{{"收益证据的对照、盲测与总预算"}}:::adr_proposed;
  %% 分期带 (按 level 分组；带内按 id 排序，Git diff 友好)
  subgraph band_L1["L1 · 契约与双宿主研究"]
    l1_api_freeze["双宿主公共协议与边界定案"]:::pending;
    l1_dsh_probe["DSH 原生会话与团队能力探针"]:::pending;
    l1_eval_protocol["冻结实用场景和收益评测协议"]:::pending;
    l1_graph_contract["动态图与有界 loop 语义规格"]:::pending;
    l1_pi_probe["Pi 原生扩展与委派能力探针"]:::passed;
    l1_replan["研究毕业与实现图增量人审"]:::pending;
    l1_review["人审目标、范围与研究计划"]:::passed;
  end
  subgraph band_L2["L2 · 宿主无关内核"]
    l2_artifact_port["不可变产物与验证引用"]:::pending;
    l2_graph_model["图编译器与原子修订"]:::pending;
    l2_host_port["宿主 ports 与委托协议"]:::pending;
    l2_kernel_verification["内核完整性纵向核验"]:::pending;
    l2_policy["授权、观测与总预算服务"]:::pending;
    l2_public_contracts["实现无副作用协议层"]:::pending;
    l2_runtime["会话归约与效果恢复"]:::pending;
    l2_scheduler["租约、资源冲突与公平调度"]:::pending;
    l2_state_store["执行 journal、投影和 outbox"]:::pending;
  end

  %% 边
  l1_review -->|"depends on"| l1_dsh_probe;
  l1_review -->|"depends on"| l1_pi_probe;
  l1_review -->|"depends on"| l1_graph_contract;
  l1_review -->|"depends on"| l1_eval_protocol;
  l1_dsh_probe -->|"depends on"| l1_api_freeze;
  l1_pi_probe -->|"depends on"| l1_api_freeze;
  l1_graph_contract -->|"depends on"| l1_api_freeze;
  l1_eval_protocol -->|"depends on"| l1_api_freeze;
  l1_api_freeze -->|"depends on"| l1_replan;
  l1_replan -->|"depends on"| l2_public_contracts;
  l2_public_contracts -->|"depends on"| l2_state_store;
  l2_public_contracts -->|"depends on"| l2_graph_model;
  l2_public_contracts -->|"depends on"| l2_policy;
  l2_public_contracts -->|"depends on"| l2_host_port;
  l2_state_store -->|"depends on"| l2_artifact_port;
  l2_graph_model -->|"depends on"| l2_scheduler;
  l2_policy -->|"depends on"| l2_scheduler;
  l2_state_store -->|"depends on"| l2_scheduler;
  l2_scheduler -->|"depends on"| l2_runtime;
  l2_host_port -->|"depends on"| l2_runtime;
  l2_artifact_port -->|"depends on"| l2_runtime;
  l2_runtime -->|"depends on"| l2_kernel_verification;
  adr_0001 -.->|"decides"| l2_host_port;
  adr_0002 -.->|"decides"| l1_graph_contract;
  adr_0003 -.->|"decides"| l2_policy;
  adr_0004 -.->|"decides"| l2_state_store;
  adr_0008 -.->|"decides"| l1_eval_protocol;

  %% 样式定义
  classDef adr_proposed fill:#ffb74d,stroke:#ef6c00;
  classDef pending fill:#8a8f98,stroke:#5b5f66;
  classDef passed fill:#16a34a,stroke:#0e7a37;

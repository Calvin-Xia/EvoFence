graph TD;
%% entry: 将当前 Git/worktree/子 CLI 串行候选控制器重设为 Graph Engineering 驱动的能力演化内核：DSH 与 Pi 同等首发，宿主执行而内核决策，结合长程编码、多 agent 协作与经过验证的长期演化。2026-10-01设计交付后用户已授权完整实施，采用同目录串行新session继承与handoff接力。
%% exit: 交付双宿主可用、可恢复、可解释的能力演化内核，并依据冻结协议提供真实受控收益证据与最终人审材料；未知、负结果和预算不足如实保留，不把实施或图完成当收益成立。发布另需明确授权。
%% 验收标准:
%% - DSH 与 Pi 各自在原生持续会话中完成一次包含动态子图、多 agent、验证、失败修复与恢复的真实编码任务；不得以调用 evofence run 或安装成功代替。
%% - 同一任务合同下，所有必须分支均有可核验证据；共享文件写入、合并、资源预算和取消具有明确责任与可重放记录。
%% - 在授权范围内自动调整与验证晋升；权限扩大、发布与破坏性操作由授权策略裁决；不宣称工具 hooks 等于 OS 沙箱。
%% - 具备任务完成、候选验证、能力晋升、宿主激活四个独立语义；失败或证据缺失不被抹成成功。
%% - 用冻结协议在未见任务上比较同模型与相同总预算下原 harness、图编排、图编排加长期演化；计入规划、委派、评测和学习的全部开销并提供消融与不确定性。
%% - 能力资产可追溯来源、适用范围、版本与评测证据；可撤销退化资产并继续普通宿主任务。
%% - 内核与协议可独立导入，无 CLI、Git、原生 SQLite 或 super-plumber 强制依赖；DSH/Pi 通过相同 host contract suite。
%% - 允许 breaking change，但旧 ledger/config/graph 历史保持原样；新版数据独立命名与版本化，发布另需明确授权。
%% 边样式图例:
%% decides/fallback/iterates = 虚线箭头；relates = 点线；shares_context = 无箭头实线；其余 = 实线箭头
  %% 节点定义 (按状态着色)
  %% 知识顶点 (context/ADR 横切领域知识，不入分期带)
  adr_0005{{"任务完成、评价、晋升与激活分离"}}:::adr_proposed;
  adr_0007{{"长期能力资产的来源与范围"}}:::adr_proposed;
  adr_0008{{"收益证据的对照、盲测与总预算"}}:::adr_proposed;
  adr_0009{{"轻量协议内核与可选基础设施"}}:::adr_proposed;
  adr_0010{{"全面 breaking 与旧数据保留"}}:::adr_proposed;
  %% 分期带 (按 level 分组；带内按 id 排序，Git diff 友好)
  subgraph band_L4["L4 · 长期演化与受控收益"]
    l4_asset_registry["能力资产版本与资格"]:::pending;
    l4_capability_trial["受控能力收益与消融试验"]:::pending;
    l4_evolution_eval["候选与长期能力独立评价"]:::pending;
    l4_experience["轨迹提炼与候选生成"]:::pending;
    l4_learning_scenario["跨任务学习与可撤销演化场景"]:::pending;
    l4_promotion["验证晋升与宿主激活事务"]:::pending;
    l4_regression_revocation["退化检测与撤销传播"]:::pending;
    l4_retrieval["适用经验检索与注入"]:::pending;
  end
  subgraph band_L5["L5 · 消费面与最终验收"]
    l5_accept["最终人审与目标验收"]:::pending;
    l5_cli_observability["薄 CLI 与原生观测视图"]:::pending;
    l5_legacy_boundary["旧格式只读边界与 breaking 指南"]:::pending;
    l5_public_sdk["SDK 消费面与最小嵌入示例"]:::pending;
    l5_release_plan["打包与交付边界核验"]:::pending;
    l5_sp_bridge["super-plumber 可选互操作"]:::pending;
  end

  %% 边
  l4_asset_registry -->|"depends on"| l4_experience;
  l4_asset_registry -->|"depends on"| l4_retrieval;
  l4_asset_registry -->|"depends on"| l4_evolution_eval;
  l4_experience -->|"depends on"| l4_promotion;
  l4_evolution_eval -->|"depends on"| l4_promotion;
  l4_promotion -->|"depends on"| l4_regression_revocation;
  l4_retrieval -->|"depends on"| l4_regression_revocation;
  l4_promotion -->|"depends on"| l4_learning_scenario;
  l4_retrieval -->|"depends on"| l4_learning_scenario;
  l4_regression_revocation -->|"depends on"| l4_learning_scenario;
  l4_learning_scenario -->|"depends on"| l4_capability_trial;
  l4_promotion -->|"depends on"| l5_public_sdk;
  l5_public_sdk -->|"depends on"| l5_cli_observability;
  l4_regression_revocation -->|"depends on"| l5_cli_observability;
  l5_public_sdk -->|"depends on"| l5_sp_bridge;
  l4_asset_registry -->|"depends on"| l5_legacy_boundary;
  l5_cli_observability -->|"depends on"| l5_release_plan;
  l5_sp_bridge -->|"depends on"| l5_release_plan;
  l5_legacy_boundary -->|"depends on"| l5_release_plan;
  l4_capability_trial -->|"depends on"| l5_release_plan;
  l5_release_plan -->|"depends on"| l5_accept;
  adr_0005 -.->|"decides"| l4_promotion;
  adr_0007 -.->|"decides"| l4_asset_registry;
  adr_0007 -.->|"decides"| l4_retrieval;
  adr_0008 -.->|"decides"| l4_capability_trial;
  adr_0009 -.->|"decides"| l5_public_sdk;
  adr_0009 -.->|"decides"| l5_sp_bridge;
  adr_0010 -.->|"decides"| l5_legacy_boundary;

  %% 样式定义
  classDef adr_proposed fill:#ffb74d,stroke:#ef6c00;
  classDef pending fill:#8a8f98,stroke:#5b5f66;

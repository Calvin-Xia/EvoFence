# graph CLI transient locks
# Super Plumber topology state: process state for this workspace's graphs, not product source. It
# travels with this developer's workspace and is not part of the package. The tracked readable
# exports are the root set (CONTEXT-MAP.md, DECISIONS.md, docs/adr, docs/contexts — the
# evofence-ts-refactor, i.e. 0.4.0, layout) plus docs/<graph-name>/{CONTEXT-MAP.md,DECISIONS.md,adr,contexts}
# for evofence-ops-evidence, evofence-042-hardening and evofence-harness-kernel.
.graph/

# pi goal-tracking state (machine-local)
.pi/goals/
.pi/.goals-pool-snapshot.json*

# guard test scratch (regenerated per run)
test/protocol-guard/.work/

# Process records (handoffs, lane briefs, review dossiers, status): kept locally, not in git/PR
/docs/evofence-harness-kernel/execution/

# Generated evidence / test-run artifacts: kept on disk, not part of the published tree
/src/hosts/*/evidence/
/src/learning/*/evidence/
/src/storage/*/evidence/
/src/evaluation/*/evidence/
/verification/kernel/evidence/*
!/verification/kernel/evidence/relocation.json
!/verification/kernel/evidence/pre-fix/
/verification/kernel/evidence/pre-fix/*
!/verification/kernel/evidence/pre-fix/relocation-sources.json
!/verification/kernel/evidence/pre-fix/repeatability.json
/integrations/deepseek-harness/evidence/*
!/integrations/deepseek-harness/evidence/*.mjs

# Dual-host scenario deliverables + frozen contract: kept locally, out of the PR/release surface (user decision 2026-10-02)
/scenarios/

# L4 capability-trial harness and its evidence: kept locally, out of the PR/release surface (user decision 2026-10-03). Untracked alone is not enough — without this entry a blanket `git add -A` stages the harness into the PR.
# Note: this does NOT stop local `node --test` discovery. That runner globs the filesystem and ignores .gitignore, so a local run still picks up experiments/capability/check.test.mjs and reports ~20 more tests than CI does.
/experiments/

# protocol-guard run outputs (regenerated by verify-native-protocol.ps1; kept locally)
/test/protocol-guard/EVIDENCE*.txt


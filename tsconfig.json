{
  // EvoFence build baseline (node l1_base of graph evofence-ts-refactor).
  //
  // JS MIGRATION CLOSED (R1 fix F4). The 0.3.0 migration window kept `allowJs: true`
  // plus `checkJs: false` and a `src/**/*.js` include glob so the still-JavaScript
  // 0.3.0 sources could compile into dist/. Every `src/` domain is TypeScript now, so
  // those three settings were removed: a stray `.js` under `src/` is no longer part of
  // the program, which closes the hole where it used to be emitted into `dist/`
  // completely unchecked. `scripts/check-src-policy.mjs` fails the build if one
  // reappears (see adr_0002 for the dist-only release shape this build serves).
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}

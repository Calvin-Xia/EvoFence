{
  "name": "evofence",
  "version": "0.3.0",
  "description": "Evidence-carrying evolution gate for autonomous coding agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "evofence": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "templates/",
    "docs/pi-tool-strategy.md",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dep:check": "node scripts/check-deps.mjs",
    "check": "npm run typecheck && npm run dep:check && npm test",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Calvin-Xia/EvoFence.git"
  },
  "bugs": {
    "url": "https://github.com/Calvin-Xia/EvoFence/issues"
  },
  "homepage": "https://github.com/Calvin-Xia/EvoFence#readme",
  "keywords": [
    "coding-agent",
    "agent-safety",
    "evolution",
    "evidence",
    "control-plane",
    "cli"
  ],
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}

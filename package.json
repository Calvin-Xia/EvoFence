{
  "name": "evofence",
  "version": "0.5.0",
  "description": "Evidence-carrying evolution gate for autonomous coding agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "evofence": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "default": "./dist/kernel/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./hosts/pi": {
      "types": "./dist/hosts/pi/index.d.ts",
      "default": "./dist/hosts/pi/index.js"
    },
    "./hosts/dsh": {
      "types": "./dist/hosts/dsh/index.d.ts",
      "default": "./dist/hosts/dsh/index.js"
    },
    "./storage/memory": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "templates/",
    "docs/pi-tool-strategy.md",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "src:policy": "node scripts/check-src-policy.mjs",
    "dep:check": "node scripts/check-deps.mjs",
    "check:core-imports": "node scripts/check-core-imports-baseline.mjs",
    "check:gate-parity": "node scripts/check-gate-parity.mjs",
    "check:skips": "node scripts/verify-ci-environment.mjs --skips",
    "config:doc": "npm run build && node scripts/check-config-doc.mjs",
    "check": "npm run typecheck && npm run src:policy && npm run dep:check && npm run check:core-imports && npm test",
    "test": "npm run build && node --test",
    "test:e2e": "npm run build && node --test test-e2e/cli-flow.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Calvin-Xia/EvoFence.git"
  },
  "bugs": {
    "url": "https://github.com/Calvin-Xia/EvoFence/issues"
  },
  "homepage": "https://github.com/Calvin-Xia/EvoFence#readme",
  "keywords": [
    "coding-agent",
    "agent-safety",
    "evolution",
    "evidence",
    "control-plane",
    "cli"
  ],
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
